#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&msc {
    delay-ms = <0>;
    trigger-period-ms = <10>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    warp {
        layers = <0>;
        input-processors = <&zip_wheel_scaler 4 1>;
    };

    precision {
        layers = <1>;
        input-processors = <&zip_wheel_scaler 1 2>;
    };
};

/ {
    behaviors {
        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_click: mouse_button_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&mkp>, <&mkp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <10>;
        };

        macro_w_TMute: macro_w_TMute {
            compatible = "zmk,behavior-macro";
            label = "Win Teams Mic Mute";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LALT>,
                <&macro_tap>,
                <&kp K>,
                <&macro_release>,
                <&kp LGUI &kp LALT>;
        };

        pw1: pw1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(U) &kp J &kp C &kp DOT &kp N3 &kp N0 &kp N7 &kp N0 &kp EXCL>;
            label = "PW1";
        };

        pw2: pw2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(U) &kp J &kp C &kp DOT &kp N2 &kp N0 &kp N2 &kp N6 &kp N0 &kp N5 &kp N0 &kp N1>;
            label = "PW2";
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        CtrlA {
            bindings = <&kp LC(A)>;
            key-positions = <13 25>;
        };

        CtrlC {
            bindings = <&kp LC(C)>;
            key-positions = <27 41>;
        };

        CtrlF {
            bindings = <&kp LC(F)>;
            key-positions = <16 28>;
        };

        CtrlH {
            bindings = <&kp LC(H)>;
            key-positions = <18 32>;
        };

        CtrlShiftL {
            bindings = <&kp LC(LS(L))>;
            key-positions = <22 36>;
        };

        CtrlB {
            bindings = <&kp LC(B)>;
            key-positions = <29 42>;
        };

        CtrlP {
            bindings = <&kp LC(P)>;
            key-positions = <10 22>;
        };

        CtrlR {
            bindings = <&kp LC(R)>;
            key-positions = <4 16>;
        };

        CtrlS {
            bindings = <&kp LC(S)>;
            key-positions = <13 25>;
        };

        CtrlT {
            bindings = <&kp LC(T)>;
            key-positions = <5 17>;
        };

        CtrlV {
            bindings = <&kp LC(V)>;
            key-positions = <28 41>;
        };

        CtrlW {
            bindings = <&kp LC(W)>;
            key-positions = <2 14>;
        };

        CtrlX {
            bindings = <&kp LC(X)>;
            key-positions = <26 40>;
        };

        CtrlY {
            bindings = <&kp LC(Y)>;
            key-positions = <6 18>;
        };

        CtrlZ {
            bindings = <&kp LC(Z)>;
            key-positions = <25 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE  &kp Q         &kp W         &kp E         &kp R        &kp T                                  &kp Y        &kp U            &kp I      &kp O       &kp P      &kp BACKSPACE
&kp TAB     &kp A         &kp S         &kp D         &kp F        &kp G                                  &kp H        &kp J            &kp K      &kp L       &kp MINUS  &kp ENTER
&kp LSHFT   &kp Z         &kp X         &kp C         &kp V        &kp B        &macro_w_TMute    &tog 1  &kp N        &kp M            &kp COMMA  &kp PERIOD  &kp UP     &kp EQUAL
&kp LCTRL   &kp LEFT_WIN  &kp LEFT_ALT  &kp QUESTION  &lt 1 SPACE  &lt 0 LANG2                            &lt 3 LANG1  &lt 2 BACKSPACE  &kp DEL    &kp LEFT    &kp DOWN   &kp RIGHT
            >;

            sensor-bindings =
                <&rot_kp C_VOL_UP C_VOL_DN>,
                <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        layer_1 {
            bindings = <
&trans  &kp PERCENT    &kp N7        &kp N8           &kp N9        &kp ASTERISK                  &kp DOUBLE_QUOTES  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp TILDE  &kp PIPE       &trans
&trans  &kp DOT        &kp NUMBER_4  &kp N5           &kp NUMBER_6  &kp PLUS                      &kp SQT            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CARET  &kp BACKSLASH  &trans
&trans  &kp N0         &kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3  &kp SLASH     &none    &none  &kp AT_SIGN        &kp AMPERSAND         &kp HASH               &kp GRAVE  &kp PAGE_UP    &trans
&trans  &kp SEMICOLON  &kp COLON     &kp EXCLAMATION  &none         &none                         &none              &trans                &trans                 &kp HOME   &kp PAGE_DOWN  &kp END
            >;

            sensor-bindings =
                <&rot_kp C_VOL_UP C_VOL_DN>,
                <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        layer_2 {
            bindings = <
&none  &none  &none  &none  &none  &none                  &none  &kp F9  &kp F10  &kp F11  &kp F12  &none
&none  &none  &none  &none  &none  &none                  &none  &kp F5  &kp F6   &kp F7   &kp F8   &none
&none  &none  &pw1   &pw2   &none  &none  &none    &none  &none  &kp F1  &kp F2   &kp F3   &kp F4   &none
&none  &none  &none  &none  &none  &none                  &none  &none   &none    &none    &none    &none
            >;

            sensor-bindings = <&rot_kp C_VOL_UP C_VOL_DN    &mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        layer_4 {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none                                &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none           &bt BT_CLR    &none  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &bt BT_CLR_ALL                       &none  &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&rot_kp C_VOL_UP C_VOL_DN    &rot_kp PG_UP PG_DN>;
        };
    };
};
